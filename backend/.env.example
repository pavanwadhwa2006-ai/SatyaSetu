# ============================================================
# SatyaSetu Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Supabase project URL (from Supabase → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SERVER SIDE ONLY, never expose to browser
# From Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT secret — for verifying user JWTs server-side
# From Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Application environment (development / production)
APP_ENV=development

# Optional: override default port
# PORT=8000
